# =============================================================================
#  Сундук — значения стека. Скопируйте этот файл в `.env` рядом с
#  docker-compose.portable.yml и правьте только нужные строки.
#
#  Так работает в Dockge (файл .env в каталоге стека) и в обычном
#  `docker compose`. В Portainer те же имена задаются в разделе
#  «Environment variables» при создании стека (файл .env там не читается,
#  если стек создан не из git-репозитория).
#
#  Значение по умолчанию — `localhost`: панель и ссылки открываются только с
#  того же компьютера. Для доступа из локальной сети впишите IP этого
#  компьютера (в Windows: ipconfig, например 192.168.1.50).
# =============================================================================

# ---- Порты -----------------------------------------------------------------
# Панель: открывать только в локальной сети, на роутере не пробрасывать.
ADMIN_PORT=8080
# Внешние ссылки: этот порт открывается наружу (или HTTPS-прокси перед ним).
PUBLIC_PORT=8081

# ---- Адрес снаружи ---------------------------------------------------------
# IP, домен или полный https-адрес. Из него строятся все внешние ссылки.
PUBLIC_ADDRESS=localhost
#   IP:     PUBLIC_ADDRESS=95.31.37.196
#   домен:  PUBLIC_ADDRESS=files.example.com
#   HTTPS:  PUBLIC_ADDRESS=https://files.example.com   (за reverse-proxy)

# ---- Что показывает панель -------------------------------------------------
# Linux — весь сервер:
HOST_ROOT=/
# Windows — отдельная папка (рекомендуется; весь диск C:\ панель тоже
# перечислит, но упрётся в системные файлы вроде pagefile.sys):
#HOST_ROOT=C:\Share
# macOS — корень / в Docker Desktop недоступен (там файловая система его
# Linux-ВМ), поэтому указывают реальный каталог:
#HOST_ROOT=/Users/имя

# ---- Необязательное --------------------------------------------------------
# Кому отвечает панель (по умолчанию только локальные сети). Пусто = по умолчанию.
#LAN_ALLOWLIST=192.168.0.0/16,10.8.0.0/24
# Имя контейнера и том — нужны, чтобы поднять второй экземпляр рядом.
#CONTAINER_NAME=sunduk
#DATA_VOLUME=sunduk_data
# Образ: ghcr.io/afanagr/sunduk:latest (по умолчанию), либо sunduk:latest —
# если образ уже лежит локально (docker load из sunduk-<версия>.tar).
#SUNDUK_IMAGE=sunduk:latest
