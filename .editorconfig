# Единый стиль для всех редакторов: UTF-8 без BOM и LF, потому что код
# разворачивается на Linux-сервере (см. .gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{js,css,html}]
indent_size = 2

[*.md]
# В markdown два пробела в конце строки — это перенос, удалять их нельзя.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
